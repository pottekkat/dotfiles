# Ghostty 1.3.1

# Theme names gained capitals and spaces; the old "catppuccin-macchiato" now
# fails silently. `ghostty +list-themes` is the authority.
theme = Catppuccin Mocha

# Fonts
font-family = JetBrainsMono Nerd Font
font-size = 12

# Values merge with the defaults, so these three are the only changes.
# ssh-terminfo installs Ghostty's terminfo on remote hosts; without it
# TERM=xterm-ghostty is unknown on the far end and keys and colors misbehave.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Cursor
cursor-style = block
cursor-style-blink = false

# Matches iTerm2's transparency of 0.097.
background-opacity = 0.90

# Native macOS window tabs are drawn by AppKit and cannot be restyled. "tabs"
# is Ghostty's own tab bar. Applies to new windows only.
macos-titlebar-style = tabs

# Left option sends Esc+ for readline and nvim bindings; right option stays
# normal for characters like #.
macos-option-as-alt = left

# Delete to start of line.
keybind = cmd+backspace=esc:w
