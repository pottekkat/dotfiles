# Ghostty 1.3.1

# Theme names gained capitals and spaces; the old "catppuccin-macchiato" now
# fails silently. `ghostty +list-themes` is the authority.
theme = Catppuccin Mocha

# Fonts
font-family = JetBrainsMono Nerd Font
font-size = 12

# Values merge with the defaults, so these three are the only changes.
# ssh-terminfo installs Ghostty's terminfo on remote hosts; without it
# TERM=xterm-ghostty is unknown on the far end and keys and colors misbehave.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Cursor
cursor-style = block
cursor-style-blink = false

# Matches iTerm2's transparency of 0.097.
background-opacity = 0.90

# Puts the tabs in the titlebar row instead of a separate bar below it, which
# is one row shorter. On macOS 26 the titlebar still renders as system glass
# either way; this is for the layout, not the color.
macos-titlebar-style = tabs

# macos-option-as-alt is left unset on purpose: it already defaults to true on
# a U.S. layout, so both option keys send Esc+ for readline and nvim. Setting
# it to `left` only takes that away from the right one.

# Clear the line, as iTerm2 did. 0x15 is ctrl+u, which zsh binds to
# kill-whole-line. The old esc:w sent Meta-w (copy-region-as-kill) and did
# nothing.
keybind = cmd+backspace=text:\x15
